# Flight API — environment variables
# Copy this file to .env and fill in secrets before running docker compose

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flight_api
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8080

# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
