LOAD DATABASE
    FROM mssql://sa:U76hqeHk1LMgbU2@host.docker.internal:14330/SearchAPI
    INTO postgresql://postgres:123456@host.docker.internal:5432/flight_api

WITH
    include drop,
    create tables,
    create indexes,
    reset sequences,
    workers = 1,
    concurrency = 1

CAST
    type bigint   to bigint   drop typemod,
    type int      to integer  drop typemod,
    type smallint to smallint drop typemod,
    type tinyint  to smallint drop typemod,
    type float    to float8   drop typemod,
    type real     to real     drop typemod,
    type money    to numeric  drop typemod,
    type numeric  to numeric,
    type bit      to boolean  using (lambda (x) (= 1 (if (stringp x) (parse-integer x) x))),
    type nvarchar to text     drop typemod,
    type varchar  to text     drop typemod,
    type nchar    to text     drop typemod,
    type char     to text     drop typemod,
    type ntext    to text,
    type text     to text,
    type datetime  to timestamptz,
    type datetime2 to timestamptz,
    type date      to date,
    type time      to time,
    type uniqueidentifier to uuid

INCLUDING ONLY TABLE NAMES LIKE
    'tblAirlineType', 'tblAirlines', 'tblAircraft', 'tblCurrency', 'tblPassengerType',
    'tblGeoContinent', 'tblGeoCountry', 'tblGeoCity', 'tblGeoAirport',
    'tblBaggageContinent', 'tblBaggageCountry', 'tblBaggageCity', 'tblBaggageAirport',
    'tblPcc', 'tblClassAndNote',
    'tblUserRole', 'tblUserAccount', 'tblUserAccountAPI', 'TokenDevice',
    'tblAgent', 'tblAgentPcc', 'tblPartner', 'tblAgentPartner',
    'tblLccInfo', 'tblAirlineIgnore', 'tblCommission',
    'tblBooking', 'tblBookingFlight', 'tblBookingSegment',
    'tblPassenger', 'tblTicket', 'tblBaggages', 'tblInsurance', 'tblInvoice',
    'tblCarRental', 'tblTripCancellation', 'tblTripTour', 'tblTripVisa'
    IN SCHEMA 'dbo';
